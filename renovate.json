{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 9am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "マイナー・パッチ更新はまとめて 1 つの PR にし、CI が通れば自動でマージする",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "メジャー更新は依存ダッシュボードで承認したときだけ PR を作る",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "GitHub Actions のアクションとイメージは別の PR にまとめる",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Cargo.lock はコミットしていないので、Cargo.toml の範囲を最新に合わせる",
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    }
  ]
}
