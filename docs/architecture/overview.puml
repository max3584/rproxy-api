@startuml overview
!pragma layout smetana
title rproxy：全体の構成
skinparam componentStyle rectangle

actor "利用者" as user
actor "クライアント" as client
node "Keycloak" as kc

package "UI（TCP-UDP-rproxy-ui / Next.js）" {
  [画面] as ui_pages
  [API route\n(/api/forward/*)] as ui_api
}
database "MariaDB\nforward_rules\nforward_rules_log" as db

package "rproxy-api（Rust / tokio）" {
  [制御 API\n(HTTP / Unix ソケット)] as ctl
  [Registry] as reg
  [データプレーン\nL4 (TCP/UDP) / L7 (HTTP 1.1/2/3)] as dp
}
file "設定ファイル\nRPROXY_CONFIG" as cfg
file "証明書ファイル\n(certbot / cert-manager)" as certs

node "転送先\n(VM・K8s・メール・DB)" as backend
node "CrowdSec\nLAPI / AppSec" as cs
node "OIDC プロバイダ" as idp

user --> ui_pages : HTTPS
ui_pages --> kc : サインイン
ui_pages --> ui_api
ui_api --> db : 読み書き\n(書くのは UI だけ)
ui_api --> ctl : Bearer トークン\nPOST / PATCH / DELETE / GET
db ..> reg : 起動時に読む\n(enabled:false は飛ばす)
cfg ..> reg : 10 秒ごとに差分を反映
certs ..> dp : 60 秒ごとに変わったものを読み直す
ctl --> reg
reg --> dp : ルールの起動・変更・停止
client --> dp
dp --> backend
dp --> cs : 判定の取り込み / AppSec
dp --> idp : oidc ミドルウェア
@enduml
