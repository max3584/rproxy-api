@startuml internals
!pragma layout smetana
title rproxy-api：モジュールの構成
skinparam componentStyle rectangle

package "起動・定期処理" {
  [main.rs\n起動・終了・SIGHUP\n証明書/設定ファイルの確認] as main
}
package "制御プレーン" {
  [api.rs\naxum] as api
  [auth.rs\nトークン・スコープ・監査] as auth
  [unix_api.rs] as unix
  [config.rs\n設定ファイル] as config
  [db.rs\n起動時の復元] as db
}
package "Registry" {
  [registry.rs\nルールの唯一の持ち主] as registry
  [proxy.rs\nRuntime（ルールごと）] as runtime
}
package "L4 データプレーン" {
  [tcp.rs] as tcp
  [udp.rs] as udp
  [listen.rs\n待ち受け] as listen
  [balance.rs\n複数の宛先・ヘルスチェック] as balance
  [source.rs\nPROXY v1/v2・transparent] as source
  [sni.rs / starttls.rs / dtls.rs] as l4tls
}
package "L7 データプレーン（src/http/）" {
  [server.rs\nHTTP/1.1・2] as server
  [h3.rs\nHTTP/3] as h3
  [matcher.rs\nmatch 式] as matcher
  [middleware.rs\nlimit / crowdsec / auth / oidc\ncompress / resilience] as mw
  [backend.rs\nサービス・負荷分散] as backend
  [access.rs\n信頼するプロキシ・アクセスログ] as access
}
package "共通" {
  [tlsconf.rs\nTLS の設定・証明書] as tls
  [resolve.rs\n名前解決] as resolve
  [cidr.rs] as cidr
}

main --> api
main --> config
main --> db
main --> registry
api --> auth
unix --> api
api --> registry
config --> registry
db --> registry
registry --> runtime
runtime --> tcp
runtime --> udp
runtime --> server
tcp --> listen
udp --> listen
tcp --> balance
udp --> balance
tcp --> source
tcp --> l4tls
udp --> l4tls
tcp --> server : http のルール
server --> matcher
h3 --> server : 同じハンドラ
server --> mw
mw --> backend
server --> access
runtime --> tls
balance --> resolve
tcp --> cidr
@enduml
