{
 "openapi": "3.0.3",
 "info": {
  "title": "rproxy-api control API",
  "version": "see GET /capabilities and the release",
  "description": "The contract is docs/API.md; this document follows it."
 },
 "servers": [
  {
   "url": "http://127.0.0.1:8080"
  }
 ],
 "security": [
  {
   "bearer": []
  }
 ],
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     },
     "code": {
      "type": "string",
      "enum": [
       "invalid",
       "tls_config",
       "unsupported",
       "not_found",
       "already_exists",
       "static",
       "reserved",
       "bind_failed",
       "resolve_failed",
       "unauthorized",
       "forbidden",
       "internal"
      ]
     }
    },
    "description": "Every error response. `code` is stable; `error` is for people.",
    "required": [
     "error",
     "code"
    ],
    "additionalProperties": false
   },
   "Protocol": {
    "type": "string",
    "enum": [
     "tcp",
     "udp"
    ],
    "description": "Case-insensitive on input."
   },
   "SourceIp": {
    "type": "string",
    "enum": [
     "proxy",
     "proxy_v1",
     "proxy_v2",
     "transparent"
    ]
   },
   "StartTls": {
    "type": "string",
    "enum": [
     "smtp",
     "imap",
     "pop3"
    ]
   },
   "TlsRoute": {
    "type": "object",
    "properties": {
     "server_name": {
      "type": "string"
     },
     "remote_addr": {
      "type": "string"
     },
     "remote_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
     }
    },
    "required": [
     "server_name",
     "remote_addr",
     "remote_port"
    ],
    "additionalProperties": false
   },
   "Certificate": {
    "type": "object",
    "properties": {
     "cert_file": {
      "type": "string"
     },
     "chain_file": {
      "type": "string"
     },
     "key_file": {
      "type": "string"
     },
     "acme": {
      "type": "string",
      "description": "Not built in (always unsupported); use files from certbot / cert-manager."
     },
     "domains": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "additionalProperties": false
   },
   "ClientAuth": {
    "type": "object",
    "properties": {
     "mode": {
      "type": "string",
      "enum": [
       "none",
       "optional",
       "required"
      ]
     },
     "ca_file": {
      "type": "string"
     },
     "chain_file": {
      "type": "string"
     }
    },
    "additionalProperties": false
   },
   "Upstream": {
    "type": "object",
    "properties": {
     "tls": {
      "type": "boolean"
     },
     "server_name": {
      "type": "string"
     },
     "ca_file": {
      "type": "string"
     },
     "insecure_skip_verify": {
      "type": "boolean"
     },
     "cert_file": {
      "type": "string"
     },
     "chain_file": {
      "type": "string"
     },
     "key_file": {
      "type": "string"
     }
    },
    "additionalProperties": false
   },
   "TlsOptions": {
    "type": "object",
