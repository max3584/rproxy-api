# rproxy-api の設定例。.env にコピーして使う（起動ディレクトリの .env を読み込む）。
# 同じ名前の環境変数やコマンドライン引数があれば、そちらが優先される。

# 制御 API（カンマ区切りで複数指定できる。loopback 以外ならトークンと TLS が必須）
RPROXY_API_ADDR=127.0.0.1
RPROXY_API_PORT=8080
# RPROXY_API_SOCKET=/run/rproxy/api.sock
# RPROXY_API_SOCKET_MODE=660
# RPROXY_API_SOCKET_GROUP=rproxy
RPROXY_TOKEN_FILE=/etc/rproxy/tokens
# RPROXY_TLS_CERT=/etc/rproxy/tls/cert.pem
# RPROXY_TLS_KEY=/etc/rproxy/tls/key.pem
# 証明書ファイル（ルールと制御 API）が変わったかを確かめる間隔（秒）。0 で止める
# RPROXY_CERT_CHECK_SECS=60
# 証明書の期限を確かめる間隔（秒。既定 1 日）。切れたサーバ証明書は外し、すべて切れたらそのルールを止める。0 で止める
# RPROXY_CERT_EXPIRY_CHECK_SECS=86400
# 期限の何日前から警告（expiring）にするか
# RPROXY_CERT_WARN_DAYS=14

# 起動時にルールを復元する DB。forward_rules は SELECT だけでよい。API で作ったルールを保存する（トークンの persist、#144）なら
# rproxy_rules に SELECT・INSERT・UPDATE・DELETE も要る（docs/API.md の「API で作ったルールの保存」）
RPROXY_DATABASE_URL=mysql://rproxy:password@db.example:3306/rproxy

# ログ（未指定なら標準出力）
# RPROXY_LOG_FILE=/var/log/rproxy/rproxy.log
# RPROXY_LOG_KEEP=14
RPROXY_LOG_LEVEL=info

# 転送先ホスト名の再解決間隔（秒）
# RPROXY_DNS_INTERVAL=30
# 設定ファイル（YAML / JSON）かそのディレクトリ。変わると再起動なしで反映する
# RPROXY_CONFIG=./rproxy.yaml
# RPROXY_CONFIG_CHECK_SECS=10
# POST /config/reload と ACME の強い操作（POST /acme/...）を Unix ソケットからだけ受け付ける（既定 true）
# RPROXY_API_RELOAD_UNIX_ONLY=true

# v0.4 で足した項目（docs/API.md の「v0.4 の設定」）
# 制御 API の守り（#167）：クライアント証明書（none / optional / required。トークンファイルの client_cert）、
# トークンの期限の知らせ、認証の失敗が続いた送信元の一時停止（既定で有効。0 で止めない。Unix ソケットは対象外）
# RPROXY_TLS_CLIENT_CA=/etc/rproxy/tls/client-ca.pem
# RPROXY_TLS_CLIENT_AUTH=none
# RPROXY_TOKEN_WARN_DAYS=14
# RPROXY_API_LOCKOUT_FAILURES=20
# RPROXY_API_LOCKOUT_WINDOW=1m
# RPROXY_API_LOCKOUT_DURATION=5m
# rproxy_rules での名前（#144。既定はホスト名）
# RPROXY_NODE_NAME=proxy-1

# 再起動なしの更新（#174、docs/UPGRADE.md）：SIGUSR2 / POST /admin/upgrade
# RPROXY_HANDOFF_SOCKET=/run/rproxy/handoff.sock
# RPROXY_HANDOFF_TIMEOUT=30s
# RPROXY_HANDOFF_DRAIN=5m
# 自動更新（コンテナ。入口は rproxy-api launch。apt で入れた VM では off のまま）
# RPROXY_UPDATE=off
# RPROXY_UPDATE_PIN=0.4.3
# RPROXY_UPDATE_SOURCE=https://github.com/max3584/rproxy-api/releases
# RPROXY_UPDATE_CACHE=/var/cache/rproxy/update
# RPROXY_UPDATE_INTERVAL=6h
# RPROXY_UPDATE_PUBKEY=/etc/rproxy/minisign.pub
# RPROXY_UPDATE_HEALTHY=60s

# rproxy-api --check-config --diff の問い合わせ先とトークン（#169。既定は RPROXY_API_SOCKET、なければ制御 API）
# RPROXY_DIFF_API=unix:/run/rproxy/api.sock
# RPROXY_DIFF_TOKEN_FILE=/etc/rproxy/diff.token

# performance（#194・#184）：設定ファイルの global.performance が先（docs/API.md の「performance」）
# RPROXY_WORKERS=4
# RPROXY_UDP_SHARDS=1
# RPROXY_CPU_AFFINITY=none
# RPROXY_BUSY_POLL_USECS=0
# RPROXY_SPLICE=1
# RPROXY_SPLICE_AFTER=0
# RPROXY_SPLICE_FULL_READS=4
# RPROXY_SPLICE_PIPE_SIZE=0
