#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
	# v0.4: the service runs as user rproxy-api, primary group rproxy (the UI's user
	# rproxy-ui may be a member of group rproxy to share files by group read)
	if ! getent group rproxy >/dev/null; then
		groupadd --system rproxy
	fi
	if getent passwd rproxy >/dev/null && ! getent passwd rproxy-api >/dev/null; then
		# from v0.3: rename the user, keeping its uid (and so the owner of its files);
		# usermod refuses while the old process runs, and v0.3 -> v0.4 restarts anyway
		if [ -d /run/systemd/system ] && systemctl is-active --quiet rproxy-api; then
			systemctl stop rproxy-api || true
			restart_after_rename=1
		fi
		usermod -l rproxy-api -g rproxy rproxy
		echo "rproxy-api: the user rproxy is now rproxy-api (same uid)"
	fi
	if ! getent passwd rproxy-api >/dev/null; then
		useradd --system --gid rproxy --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin rproxy-api
	fi
	# the ACME helper's user (rproxy-acme-helper.service, docs/ACME.md): holds DNS-01 secrets
	if ! getent passwd rproxy-acme >/dev/null; then
		useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin rproxy-acme
	fi
	chgrp rproxy /etc/rproxy
	chmod 0750 /etc/rproxy
	# RPROXY_LOG_FILE の既定の置き場所（systemd の LogsDirectory も同じ場所を使う）
	install -d -o rproxy-api -g rproxy -m 0750 /var/log/rproxy
	# a first API token, only when there is none yet
	if [ ! -e /etc/rproxy/tokens ]; then
		umask 027
		od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > /etc/rproxy/tokens
		echo >> /etc/rproxy/tokens
		chgrp rproxy /etc/rproxy/tokens
		echo "rproxy-api: generated an API token in /etc/rproxy/tokens"
	fi
	# first install only: move the control API off a port that is already taken
	# (CrowdSec's local API, for one, listens on 127.0.0.1:8080 by default)
	if [ -z "$2" ] && command -v ss >/dev/null; then
		port=$(sed -n 's/^RPROXY_API_PORT=//p' /etc/rproxy/rproxy.env | tail -n1)
		port=${port:-8080}
		if [ -n "$(ss -Hltn "sport = :$port")" ]; then
			for p in $(seq 8081 8099); do
				if [ -z "$(ss -Hltn "sport = :$p")" ]; then
					sed -i "s/^RPROXY_API_PORT=.*/RPROXY_API_PORT=$p/" /etc/rproxy/rproxy.env
					echo "rproxy-api: port $port is in use; the control API will listen on $p (RPROXY_API_PORT in /etc/rproxy/rproxy.env)"
					break
				fi
			done
		fi
	fi
fi

#DEBHELPER#

# an upgrade of a running service (#174, docs/UPGRADE.md): within the same
# major.minor the running process hands its sockets to the new binary (SIGUSR2,
# no connection is cut); another minor, or a release that says so
# (/usr/share/rproxy-api/restart-required), restarts it
if [ "$1" = "configure" ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	if [ -n "${restart_after_rename:-}" ]; then
		echo "rproxy-api: $2 -> $(dpkg-query -W -f='${Version}' rproxy-api 2>/dev/null || true); starting as rproxy-api"
		systemctl start rproxy-api || true
	elif systemctl is-active --quiet rproxy-api; then
		new=$(dpkg-query -W -f='${Version}' rproxy-api 2>/dev/null || true)
		old_minor=$(echo "$2" | cut -d. -f1,2)
		new_minor=$(echo "$new" | cut -d. -f1,2)
		if [ -n "$new" ] && [ "$old_minor" = "$new_minor" ] && [ ! -e /usr/share/rproxy-api/restart-required ]; then
			pid=$(systemctl show -p MainPID --value rproxy-api)
			now=$pid
			kill -USR2 "$pid" 2>/dev/null || true
			# the new process takes over within --handoff-timeout (30s); wait a little longer
			i=0
			while [ $i -lt 90 ]; do
				now=$(systemctl show -p MainPID --value rproxy-api)
				if [ -n "$now" ] && [ "$now" != 0 ] && [ "$now" != "$pid" ]; then
					break
				fi
				sleep 0.5
				i=$((i + 1))
			done
			if [ "$now" != "$pid" ] && [ "$now" != 0 ]; then
				echo "rproxy-api: $2 -> $new without a restart (live upgrade: process $pid -> $now)"
			else
				echo "rproxy-api: the live upgrade did not complete (see journalctl -u rproxy-api); restarting"
				systemctl restart rproxy-api || true
			fi
		else
			echo "rproxy-api: $2 -> $new; restarting"
			systemctl restart rproxy-api || true
		fi
	fi
fi
