# rproxy-api の設定（systemd の EnvironmentFile）。変更したら systemctl restart rproxy-api。
# 項目の一覧は /usr/share/doc/rproxy-api/README.md。

# 制御 API（カンマ区切りで複数指定できる。loopback 以外なら TLS も必須）
RPROXY_API_ADDR=127.0.0.1
RPROXY_API_PORT=8080
# Unix ソケットでも受ける（RPROXY_API_PORT=0 で TCP を閉じる）。モードとグループで使える利用者を絞る
# RPROXY_API_SOCKET=/run/rproxy/api.sock
# RPROXY_API_SOCKET_MODE=660
# RPROXY_API_SOCKET_GROUP=rproxy
# パッケージのインストール時に 1 つ生成する（1 行に 1 つ。追加・削除したら systemctl reload rproxy-api）
RPROXY_TOKEN_FILE=/etc/rproxy/tokens
# RPROXY_TLS_CERT=/etc/rproxy/tls/cert.pem
# RPROXY_TLS_KEY=/etc/rproxy/tls/key.pem
# 証明書ファイル（ルールと制御 API）が変わったかを確かめる間隔（秒）。certbot などの更新を自動で反映する。0 で止める
# RPROXY_CERT_CHECK_SECS=60
# 証明書の期限を確かめる間隔（秒。既定 1 日）。切れたサーバ証明書は外し、すべて切れたらそのルールを止める。0 で止める
# RPROXY_CERT_EXPIRY_CHECK_SECS=86400
# 期限の何日前から警告（expiring）にするか
# RPROXY_CERT_WARN_DAYS=14

# 起動時にルールを復元する DB。forward_rules は SELECT だけでよい。API で作ったルールを保存する（トークンの persist）なら
# rproxy_rules に SELECT・INSERT・UPDATE・DELETE も要る（/usr/share/doc/rproxy-api/API.md の「API で作ったルールの保存」）
# RPROXY_DATABASE_URL=mysql://rproxy:password@db.example:3306/rproxy
# rproxy_rules での名前（既定はホスト名）
# RPROXY_NODE_NAME=proxy-1

# 設定ファイル（YAML。ここのルールは API から変更できない固定ルールになる。例: /usr/share/doc/rproxy-api/examples/rproxy.example.yaml）
# RPROXY_CONFIG=/etc/rproxy/rproxy.yaml
# ディレクトリも指定できる（中の *.yaml / *.yml / *.json を名前の順に読む）。変わると再起動なしで反映する
# RPROXY_CONFIG_CHECK_SECS=10
# POST /config/reload と ACME の強い操作（POST /acme/...）を Unix ソケットからだけ受け付ける（既定 true）
# RPROXY_API_RELOAD_UNIX_ONLY=true

# ログ（JSON Lines）。日ごとに rproxy.<日付>.log へ分かれ、RPROXY_LOG_KEEP を超えた古いものは消す（logrotate は不要）
# 行を消すかコメントにすると標準出力（journalctl -u rproxy-api）に出る
RPROXY_LOG_FILE=/var/log/rproxy/rproxy.log
RPROXY_LOG_KEEP=14
RPROXY_LOG_LEVEL=info

# 制御 API の守り：クライアント証明書（none / optional / required。トークンファイルの client_cert）、
# トークンの期限の知らせ、認証の失敗が続いた送信元の一時停止（既定で有効。0 で止めない。Unix ソケットは対象外）
# RPROXY_TLS_CLIENT_CA=/etc/rproxy/tls/client-ca.pem
# RPROXY_TLS_CLIENT_AUTH=none
# RPROXY_TOKEN_WARN_DAYS=14
# RPROXY_API_LOCKOUT_FAILURES=20
# RPROXY_API_LOCKOUT_WINDOW=1m
# RPROXY_API_LOCKOUT_DURATION=5m

# 再起動なしの更新（SIGUSR2 / POST /admin/upgrade。パッケージの更新で同じマイナーなら自動で使う。/usr/share/doc/rproxy-api/UPGRADE.md）
# RPROXY_HANDOFF_SOCKET=/run/rproxy/handoff.sock
# RPROXY_HANDOFF_TIMEOUT=30s
# RPROXY_HANDOFF_DRAIN=5m
# 自動更新（RPROXY_UPDATE*）はコンテナ向け。VM（apt・install.sh）では off のまま

# performance（設定ファイルの global.performance が先。どれも起動時だけ効く）
# RPROXY_WORKERS=4
# RPROXY_UDP_SHARDS=1
# RPROXY_CPU_AFFINITY=none
# RPROXY_BUSY_POLL_USECS=0
# RPROXY_SPLICE=1
