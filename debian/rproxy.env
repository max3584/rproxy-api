# rproxy-api の設定（systemd の EnvironmentFile）。変更したら systemctl restart rproxy-api。
# 項目の一覧は /usr/share/doc/rproxy-api/README.md。

# 制御 API（カンマ区切りで複数指定できる。loopback 以外なら TLS も必須）
RPROXY_API_ADDR=127.0.0.1
RPROXY_API_PORT=8080
# パッケージのインストール時に 1 つ生成する（1 行に 1 つ。追加・削除したら systemctl reload rproxy-api）
RPROXY_TOKEN_FILE=/etc/rproxy/tokens
# RPROXY_TLS_CERT=/etc/rproxy/tls/cert.pem
# RPROXY_TLS_KEY=/etc/rproxy/tls/key.pem

# 起動時にルールを復元する DB（SELECT 権限だけのユーザーでよい）
# RPROXY_DATABASE_URL=mysql://rproxy:password@db.example:3306/rproxy

# 固定ルール（API から変更できないルール。例: /usr/share/doc/rproxy-api/examples/static-rules.example.json）
# RPROXY_STATIC_RULES=/etc/rproxy/static-rules.json

# ログ。未指定なら標準出力（journalctl -u rproxy-api で見る）
# RPROXY_LOG_FILE=/var/log/rproxy/rproxy.log
# RPROXY_LOG_KEEP=14
RPROXY_LOG_LEVEL=info
