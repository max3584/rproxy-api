# installed by the Debian package; override with systemctl edit rproxy-api
[Unit]
Description=rproxy-api TCP/UDP forwarder
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
# READY=1 once started; a live upgrade (SIGUSR2, #174) hands the service to the
# new process with MAINPID= (sent by the old process, hence NotifyAccess=all)
Type=notify
NotifyAccess=all
User=rproxy
Group=rproxy
# RPROXY_* settings, e.g. RPROXY_API_ADDR, RPROXY_TOKEN_FILE, RPROXY_STATIC_RULES, RPROXY_DATABASE_URL
EnvironmentFile=/etc/rproxy/rproxy.env
ExecStart=/usr/bin/rproxy-api
# re-read the settings file, tokens and certificates; the settings file is
# checked first (same user and environment), and a mistake fails the reload
# without signalling (`systemctl reload` reports it; see journalctl)
ExecReload=/usr/bin/rproxy-api --check-config
ExecReload=/bin/kill -HUP $MAINPID
# a live upgrade to the binary on disk (same major.minor; docs/UPGRADE.md):
#   systemctl kill -s USR2 --kill-whom=main rproxy-api
Restart=on-failure
RestartSec=2

# CAP_NET_BIND_SERVICE: ports below 1024
# CAP_NET_ADMIN: source_ip transparent (IP_TRANSPARENT). Drop it with systemctl edit if unused.
# See docs/PERMISSIONS.md.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
# port ranges open one socket per port
LimitNOFILE=65536

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/rproxy
LogsDirectory=rproxy
LogsDirectoryMode=0750
# /var/lib/rproxy: global.acme.storage (ACME account keys and certificates, docs/ACME.md)
StateDirectory=rproxy
StateDirectoryMode=0750
# /run/rproxy for RPROXY_API_SOCKET (the socket's own mode and group limit access)
RuntimeDirectory=rproxy
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
