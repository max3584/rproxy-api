# /etc/systemd/system/rproxy-api.service
[Unit]
Description=rproxy-api TCP/UDP forwarder
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=simple
User=rproxy
Group=rproxy
# RPROXY_* settings, e.g. RPROXY_API_ADDR, RPROXY_TOKEN_FILE, RPROXY_STATIC_RULES, RPROXY_DATABASE_URL
EnvironmentFile=/etc/rproxy/rproxy.env
ExecStart=/usr/local/bin/rproxy-api
# re-read tokens and certificates
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# ports below 1024; add CAP_NET_ADMIN for source_ip: transparent
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# port ranges open one socket per port
LimitNOFILE=65536

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/rproxy
LogsDirectory=rproxy

[Install]
WantedBy=multi-user.target
