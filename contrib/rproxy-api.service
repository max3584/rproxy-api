# /etc/systemd/system/rproxy-api.service
[Unit]
Description=rproxy-api TCP/UDP forwarder
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=simple
User=rproxy
Group=rproxy
# RPROXY_* settings, e.g. RPROXY_API_ADDR, RPROXY_TOKEN_FILE, RPROXY_STATIC_RULES, RPROXY_DATABASE_URL
EnvironmentFile=/etc/rproxy/rproxy.env
ExecStart=/usr/local/bin/rproxy-api
# re-read tokens and certificates
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# CAP_NET_BIND_SERVICE: ports below 1024
# CAP_NET_ADMIN: source_ip transparent (IP_TRANSPARENT). Drop it with systemctl edit if unused.
# See docs/PERMISSIONS.md.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
# port ranges open one socket per port
LimitNOFILE=65536

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/rproxy
LogsDirectory=rproxy
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
